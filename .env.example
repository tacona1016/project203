# Member login — server secrets; never prefix with NEXT_PUBLIC_
SITE_SESSION_SECRET=
ADMIN_PASSWORD=

# 사이트 회원 개인 비밀번호: participant UUID를 키로 사용합니다. NEXT_PUBLIC_ 접두사 금지.
# 아래 숫자는 이해를 돕는 예시입니다. 실제 비밀번호는 .env.local 또는 Vercel에서 설정하세요.
# 길이와 문자 조합 제한은 없습니다. 빈 값은 사용할 수 없으며, 중복 비밀번호도 허용합니다.
# 실제 비밀번호는 이 예시 파일에 저장하거나 Git에 커밋하지 마세요.
# Vercel Value에는 = 뒤의 JSON만 넣고, 가장 바깥 작은따옴표는 제외합니다.
BOARD_PARTICIPANT_PASSWORDS='{"c034d591-ead6-4808-b57a-0141b2b15b4c":"1111","3424f4a5-e0d8-43b3-a4e7-84e829be2292":"2222","a9954c71-3535-4154-a288-258a070f7c36":"3333","7101d773-bbd4-4c25-a6a1-a916209d1df0":"4444","cc7f7fb5-33ab-4ddb-9032-bfd7d86f6df2":"5555","44dec4aa-8fbf-4004-b9fb-247b6d73a624":"6666","331ef432-7587-43b0-be02-c1cb24f5f903":"7777","f1d46add-8f11-4084-b18f-fd8383ace704":"8888","82deaf16-5a8e-4430-a2d0-c1d1004088d9":"9999","bc75be40-eec1-4088-9ab9-a8fa93c0c337":"1010"}'

# Supabase URL — public configuration, currently used only by the server
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Dashboard > Project Settings > API Keys > Secret key
SUPABASE_SECRET_KEY=

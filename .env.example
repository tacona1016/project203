# Server secrets: set real values only in .env.local / Vercel.
# Never commit passwords or signing keys. Use a unique password per member.
SITE_SESSION_SECRET=
BOARD_PARTICIPANT_PASSWORDS=
ADMIN_PASSWORD=
SUPABASE_SECRET_KEY=

# Public project configuration (not a secret).
NEXT_PUBLIC_SUPABASE_URL=

# JSON format only; this is a synthetic UUID, not a real member.
# {"00000000-0000-4000-8000-000000000001":"member-a-example-password"}
# Replace the synthetic UUID with participants.id in your private environment.
# Passwords are compared exactly; JSON quoting/escaping still applies.
# SITE_ACCESS_PASSWORD is retired; preserve separately only for an old-version rollback.
